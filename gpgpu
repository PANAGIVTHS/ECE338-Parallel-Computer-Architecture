#!/usr/bin/env bash
# Keeps .venv in sync with pyproject.toml and uv.lock, then runs the CLI, from any directory.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV="$ROOT/.venv"

if command -v uv >/dev/null 2>&1; then
    # An activated venv from elsewhere must not redirect the sync.
    env -u VIRTUAL_ENV uv sync --quiet --locked --project "$ROOT"
elif [[ "$ROOT/pyproject.toml" -nt "$VENV/.installed" ]]; then
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --editable "$ROOT"
    touch "$VENV/.installed"
fi

# Machine-local settings start empty, and are never committed.
[[ -e "$ROOT/config/local.yaml" ]] || printf '{}\n' > "$ROOT/config/local.yaml"

exec "$VENV/bin/gpgpu" "$@"
